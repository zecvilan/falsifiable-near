# Only needed for the optional raw-chain pipeline (`make dry-run`, `make rebuild`).
# The keyless pipeline (`make data`) and the dashboard need no variables.

# Google Cloud project billed for BigQuery queries against
# bigquery-public-data.crypto_near_mainnet_us
GOOGLE_CLOUD_PROJECT=

# Optional: JWT from https://partners.near-intents.org for the NEAR Intents Explorer API
NEAR_INTENTS_JWT=
